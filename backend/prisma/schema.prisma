// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

  generator client {
    provider        = "prisma-client"
    output          = "../generated/prisma"
    moduleFormat    = "cjs"
    // Prisma 7 requires a driver adapter to be configured on the client.
    // The adapter (e.g. @prisma/adapter-pg) is supplied when instantiating
    // PrismaClient in src/prisma/prisma.service.ts.
    previewFeatures = ["driverAdapters"]
  }

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum OrderStatus {
  PENDING_PAYMENT
  COMPLETED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  GCASH
  Maribank
}

enum ShippingMode {
  LBC
  JNT
  BOOK_OWN
}

enum UserType {
  USER
  STAFF
  ADMIN
}

// ==========================================
// AUTH & USERS
// ==========================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  type                UserType  @default(USER)
  roleId              Int?
  role                Role?     @relation(fields: [roleId], references: [id])
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions           Session[]
  authorizationCodes AuthorizationCode[]
  auditLogs          AuditLog[]
  orders             Order[] 

  @@index([email])
}

model Session {
  id           String   @id @default(uuid())
  token        String   @unique
  refreshToken String   @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([refreshToken])
}

model Application {
  id           String   @id @default(uuid())
  name         String
  clientId     String   @unique
  clientSecret String?
  redirectUri  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuthorizationCode {
  id                  String   @id @default(uuid())
  code                String   @unique
  clientId            String
  redirectUri         String
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeChallenge       String?
  codeChallengeMethod String?
  expiresAt           DateTime
  used                Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([code])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

// ==========================================
// STORE (CARDS & LISTINGS)
// ==========================================

model Card {
  id         Int       @id @default(autoincrement())
  scryfallId String    @unique
  name       String
  imageUrl   String?
  setName    String
  createdAt  DateTime  @default(now())
  
  listings   Listing[]
}

model Listing {
  id        Int      @id @default(autoincrement())
  cardId    Int
  card      Card     @relation(fields: [cardId], references: [id])
  price     Decimal
  stock     Int      @default(1)
  condition String
  language  String
  isFoil    Boolean
  createdAt DateTime @default(now())
  
  orderItems OrderItem[] 
}

// ==========================================
// ORDERS
// ==========================================

model Order {
  id            String   @id @default(uuid())
  orderNumber   String   @unique 

  // Customer Contact

  email         String
  phone         String
  firstName     String
  lastName      String
  
  // Shipping Address
  streetAddress String
  barangay      String
  city          String
  province      String
  postalCode    String

  // Order Details
  paymentMethod PaymentMethod
  shippingMode  ShippingMode
  status        OrderStatus   @default(PENDING_PAYMENT)
  
  // Financials 
  subtotal      Decimal
  shippingFee   Decimal
  total         Decimal

  // Relations
  items         OrderItem[] 
  
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  
  quantity        Int
  priceAtPurchase Decimal  
  
  // Relations
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  listingId       Int
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  
  @@index([orderId])
  @@index([listingId])
}