DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>?schema=public"
DIRECT_URL="postgresql://<username>:<password>@<host>:<port>/<database>?schema=public"
# E2E tests delete auth records; always use a disposable database here.
TEST_DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<test-database>?schema=public"
NODE_ENV="development"
PORT=3001

# JWT / SSO
JWT_SECRET="<your-jwt-secret>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Frontend / CORS
FRONTEND_ORIGINS="http://localhost:3000"
FRONTEND_LOGIN_URL="http://localhost:3000/auth"

# Cookie domain / cross-site SSO
AUTH_COOKIE_NAME="auth_session"
ALLOW_CROSS_SITE_SSO="false"

BCRYPT_SALT_ROUNDS=12

# Development seed credentials (replace before running the seed)
SEED_ADMIN_EMAIL="admin@gray-merchant.test"
SEED_ADMIN_PASSWORD="<your-admin-password>"
SEED_STAFF_CLIENT_SECRET="<your-client-secret>"

# session & security (optional)
MAX_SESSIONS_PER_USER=5
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
